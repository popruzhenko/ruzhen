generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContactTopic {
  CORRECTIONS
  SOURCES
  PARTNERSHIPS
  OTHER
}

enum SourceAccessMode {
  FULL_OPEN
  METADATA_ONLY
}

enum ContentAvailability {
  FULL_TEXT
  PARTIAL_TEXT
  SUMMARY_ONLY
  TITLE_ONLY
  PREVIEW_ONLY
}

enum EmbeddingBasis {
  FULL_TEXT
  PARTIAL_TEXT
  SUMMARY_ONLY
  TITLE_ONLY
  CLEANED_ACCESSIBLE_TEXT
}

enum CleaningMethod {
  RULE_BASED
  LLM_ASSISTED
}

enum UserRole {
  USER
  ADMIN
}

enum SourceType {
  RSS
  API
  SCRAPE
}

enum ArticleStatus {
  NEW
  NEEDS_REVIEW
  REVIEWED
  EMBEDDED
  CLUSTERED
  APPROVED
  REJECTED
}

enum ClusterStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CandidateStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ClusterRelationType {
  CONTINUES
  FOLLOW_UP
  SPLIT_FROM
}

enum ClusterArticleMethod {
  AUTO
  MANUAL
}

enum BlockType {
  FACT
  CONTEXT
  OPINION
}

enum OpinionStance {
  PRO
  CONTRA
  NEUTRAL
}

model ContactMessage {
  id        String       @id @default(uuid())
  name      String?
  email     String
  topic     ContactTopic
  title     String
  message   String
  createdAt DateTime     @default(now())

  @@index([topic])
  @@index([createdAt])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdClusters    Cluster[]          @relation("ClusterCreatedBy")
  addedClusterLinks  ClusterArticle[]   @relation("ClusterArticleAddedBy")
  reviewedCandidates ClusterCandidate[] @relation("ClusterCandidateReviewedBy")
  createdBlocks      ClusterBlock[]     @relation("ClusterBlockCreatedBy")
  sessions           Session[]
  bookmarks          Bookmark[]
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ip               String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Source {
  id            String           @id @default(uuid())
  name          String
  type          SourceType
  accessMode    SourceAccessMode @default(FULL_OPEN)
  baseUrl       String
  language      String?
  country       String?
  isActive      Boolean          @default(true)
  lastFetchedAt DateTime?

  articles Article[]

  @@unique([name, baseUrl])
}

model Article {
  id                    String               @id @default(uuid())
  sourceId              String
  url                   String               @unique
  title                 String
  summary               String?
  content               String?
  cleanedAccessibleText String?
  imageUrl              String?
  publishedAt           DateTime?
  language              String?
  country               String?
  status                ArticleStatus        @default(NEW)
  contentAvailability   ContentAvailability?
  embeddingBasis        EmbeddingBasis?
  cleaningMethod        CleaningMethod?
  embeddingModel        String?
  embedding             Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  source                Source               @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  raw                   ArticleRaw?
  clusterLinks          ClusterArticle[]
  clusterCandidates     ClusterCandidate[]

  @@index([sourceId])
  @@index([status])
  @@index([publishedAt])
  @@index([contentAvailability])
}

model ArticleRaw {
  id            String   @id @default(uuid())
  articleId     String   @unique
  rawContent    String
  fetchedAt     DateTime @default(now())
  parserVersion String?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Cluster {
  id                String             @id @default(uuid())
  humanId           String             @unique
  title             String
  summary           String?
  mainCountry       String?
  startDate         DateTime?
  status            ClusterStatus      @default(DRAFT)
  createdByUserId   String
  publishedAt       DateTime?
  embedding         Json?
  updatedAt         DateTime           @updatedAt
  createdAt         DateTime           @default(now())
  createdBy         User               @relation("ClusterCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  articleLinks      ClusterArticle[]
  candidates        ClusterCandidate[]
  blocks            ClusterBlock[]
  bookmarks         Bookmark[]
  clusterTags       ClusterTag[]
  outgoingRelations ClusterRelation[]  @relation("ClusterOutgoing")
  incomingRelations ClusterRelation[]  @relation("ClusterIncoming")

  @@index([status])
  @@index([createdByUserId])
  @@index([publishedAt])
}

model ClusterRelation {
  id            String              @id @default(uuid())
  fromClusterId String
  toClusterId   String
  type          ClusterRelationType
  createdAt     DateTime            @default(now())

  fromCluster Cluster @relation("ClusterOutgoing", fields: [fromClusterId], references: [id], onDelete: Cascade)
  toCluster   Cluster @relation("ClusterIncoming", fields: [toClusterId], references: [id], onDelete: Cascade)

  @@unique([fromClusterId, toClusterId, type])
  @@index([fromClusterId])
  @@index([toClusterId])
}

model ClusterArticle {
  clusterId     String
  articleId     String
  addedByUserId String
  addedAt       DateTime             @default(now())
  isPrimary     Boolean              @default(false)
  confidence    Float?
  method        ClusterArticleMethod

  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  addedBy User    @relation("ClusterArticleAddedBy", fields: [addedByUserId], references: [id], onDelete: Restrict)

  @@id([clusterId, articleId])
  @@index([articleId])
  @@index([addedByUserId])
}

model ClusterCandidate {
  id               String          @id @default(uuid())
  articleId        String
  clusterId        String
  score            Float
  status           CandidateStatus @default(PENDING)
  createdAt        DateTime        @default(now())
  reviewedByUserId String?
  reviewedAt       DateTime?

  article    Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  cluster    Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("ClusterCandidateReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([articleId, clusterId])
  @@index([articleId])
  @@index([clusterId])
  @@index([status])
}

model ClusterBlock {
  id              String         @id @default(uuid())
  clusterId       String
  type            BlockType
  title           String?
  content         String
  position        Int
  sourceName      String?
  sourceUrl       String?
  authorName      String?
  stance          OpinionStance?
  createdByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  cluster   Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ClusterBlockCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([clusterId, position])
  @@index([clusterId])
}

model Bookmark {
  userId    String
  clusterId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@id([userId, clusterId])
  @@index([clusterId])
}

model Tag {
  id   String @id @default(uuid())
  name String @unique

  clusterTags ClusterTag[]
}

model ClusterTag {
  clusterId String
  tagId     String

  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clusterId, tagId])
  @@index([tagId])
}
