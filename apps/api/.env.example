DATABASE_URL="postgresql://postgres:password@localhost:5432/ruzhen_dev?schema=public"

JWT_ACCESS_SECRET="your_jwt_access_secret"

OPENAI_API_KEY="your_openai_api_key"

GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Enrich tries publisher HTML, then Chromium, then existing archive.today/ph snapshots.
# Both fallbacks are enabled when these variables are absent.
ENRICH_BROWSER_ENABLED=true
ENRICH_ARCHIVE_ENABLED=true

# Existing administrator ID, required only for the parse:politics CLI.
INGESTION_ACTOR_USER_ID=
